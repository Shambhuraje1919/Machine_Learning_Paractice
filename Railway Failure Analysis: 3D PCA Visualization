{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":17131038},{"sourceType":"datasetVersion","sourceId":17129559}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/shambhurajejagadale/railway-failure-analysis-3d-pca-visualization?scriptVersionId=329978907\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nimport plotly.express as px\nimport plotly.graph_objects as go\n\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler\nfrom sklearn.decomposition import PCA\n\n# ==========================\n# LOAD DATA\n# ==========================\n\ndf = pd.read_csv(\"/kaggle/input/datasets/shambhurajejagadale/indian-railway-failure-detection-and-maintenance100k/indian_railway_predictive_maintenance_100k.csv\")\n\nprint(\"=\"*50)\nprint(\"Dataset Shape:\", df.shape)\nprint(\"=\"*50)\n\ndisplay(df.head())\n\n# ==========================\n# BASIC INFO\n# ==========================\n\nprint(\"\\nMissing Values\\n\")\nprint(df.isnull().sum().sort_values(ascending=False))\n\nprint(\"\\nData Types\\n\")\nprint(df.dtypes)\n\n# ==========================\n# FAILURE DISTRIBUTION\n# ==========================\n\nfig = px.histogram(\n    df,\n    x=\"failure_type\",\n    color=\"failure_type\",\n    title=\"Failure Type Distribution\"\n)\n\nfig.show()\n\n# ==========================\n# FAILURE SEVERITY\n# ==========================\n\nfig = px.pie(\n    df,\n    names=\"failure_severity\",\n    title=\"Failure Severity Distribution\"\n)\n\nfig.show()\n\n# ==========================\n# MISSING VALUES VISUALIZATION\n# ==========================\n\nmissing_df = (\n    df.isnull()\n    .sum()\n    .reset_index()\n)\n\nmissing_df.columns = [\"Feature\",\"Missing_Count\"]\n\nfig = px.bar(\n    missing_df,\n    x=\"Feature\",\n    y=\"Missing_Count\",\n    title=\"Missing Values by Feature\"\n)\n\nfig.update_layout(xaxis_tickangle=-45)\n\nfig.show()\n\n# ==========================\n# ENCODE CATEGORICALS\n# ==========================\n\ndf_encoded = df.copy()\n\ncat_cols = df_encoded.select_dtypes(include=\"object\").columns\n\nfor col in cat_cols:\n    le = LabelEncoder()\n    df_encoded[col] = le.fit_transform(\n        df_encoded[col].astype(str)\n    )\n\n# ==========================\n# IMPUTE MISSING VALUES\n# ==========================\n\nimputer = SimpleImputer(strategy=\"median\")\n\ndf_encoded = pd.DataFrame(\n    imputer.fit_transform(df_encoded),\n    columns=df_encoded.columns\n)\n\n# ==========================\n# CORRELATION MATRIX\n# ==========================\n\ncorr = df_encoded.corr()\n\nfig = px.imshow(\n    corr,\n    aspect=\"auto\",\n    title=\"Feature Correlation Matrix\"\n)\n\nfig.show()\n\n# ==========================\n# FEATURE IMPORTANCE TO RISK\n# ==========================\n\nrisk_corr = (\n    corr[\"risk_score\"]\n    .sort_values(ascending=False)\n)\n\nprint(\"\\nTop Correlations with Risk Score\\n\")\nprint(risk_corr.head(15))\n\n# ==========================\n# STANDARDIZE\n# ==========================\n\nscaler = StandardScaler()\n\nscaled_data = scaler.fit_transform(df_encoded)\n\n# ==========================\n# PCA\n# ==========================\n\npca = PCA(n_components=3)\n\npca_result = pca.fit_transform(scaled_data)\n\npca_df = pd.DataFrame(\n    pca_result,\n    columns=[\"PC1\",\"PC2\",\"PC3\"]\n)\n\npca_df[\"failure_type\"] = df[\"failure_type\"]\n\n# ==========================\n# EXPLAINED VARIANCE\n# ==========================\n\nexplained = pca.explained_variance_ratio_\n\nprint(\"\\nExplained Variance\\n\")\nprint(explained)\n\n# ==========================\n# PCA LOADINGS\n# ==========================\n\nloadings = pd.DataFrame(\n    pca.components_.T,\n    columns=[\"PC1\",\"PC2\",\"PC3\"],\n    index=df_encoded.columns\n)\n\nprint(\"\\nTop Features Driving PC1\\n\")\ndisplay(\n    loadings[\"PC1\"]\n    .abs()\n    .sort_values(ascending=False)\n    .head(15)\n)\n\n# ==========================\n# INTERACTIVE 3D PCA\n# ==========================\n\nfig = px.scatter_3d(\n    pca_df,\n    x=\"PC1\",\n    y=\"PC2\",\n    z=\"PC3\",\n    color=\"failure_type\",\n    opacity=0.7,\n    title=\"3D PCA Visualization of Railway Dataset\",\n    height=800\n)\n\nfig.update_traces(marker=dict(size=3))\n\nfig.show()\n\n# ==========================\n# PCA FEATURE ANALYSIS\n# ==========================\n\nfeature_strength = (\n    loadings.abs()\n    .sum(axis=1)\n    .sort_values(ascending=False)\n)\n\nprint(\"\\nMost Influential Features Across PCA Components\\n\")\n\ndisplay(\n    feature_strength.head(20)\n)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-06-24T07:28:42.022779Z","iopub.execute_input":"2026-06-24T07:28:42.023079Z","iopub.status.idle":"2026-06-24T07:28:47.416747Z","shell.execute_reply.started":"2026-06-24T07:28:42.02305Z","shell.execute_reply":"2026-06-24T07:28:47.416056Z"}},"outputs":[{"name":"stdout","text":"==================================================\nDataset Shape: (100300, 35)\n==================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"   train_id                 region   season train_type  train_age_years  \\\n0         1        Central Railway   Winte